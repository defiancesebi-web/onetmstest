generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  COMPANY_USER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum InvitationRole {
  COMPANY_ADMIN
  COMPANY_USER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model Company {
  id        String        @id @default(cuid())
  name      String
  cui       String
  status    CompanyStatus @default(TRIAL)
  createdAt DateTime      @default(now())

  /// Company logo shown in the sidebar next to the name. A small square image
  /// data URL (resized client-side on upload), so no file storage is needed.
  logo String?

  // Invoicing / legal identity of the issuer (furnizor). Filled once from the
  // in-app invoicing settings screen; required before an invoice can be issued.
  // Kept nullable so existing companies migrate cleanly and can fill them later.
  regCom        String?
  address       String?
  city          String?
  county        String?
  postalCode    String?
  country       String  @default("România")
  iban          String?
  bankName      String?
  // General contact / identity, shown on invoices.
  phone         String?
  email         String?
  website       String?
  /// Capital social — free text (e.g. "200 RON"), optional on invoices.
  shareCapital  String?
  /// Plătitor de TVA. A non-payer issues invoices with no VAT and the legal
  /// "Neplătitor de TVA" mention instead.
  vatPayer      Boolean @default(true)
  /// The invoice series (serie) this company issues under, e.g. "ONE". Numbers
  /// run continuously within the series. Must be set before issuing.
  invoiceSeries String?

  users       User[]
  invitations Invitation[]
  clients     Client[]
  orders      Order[]
  vehicles    Vehicle[]
  drivers     Driver[]
  documents   Document[]
  trips       Trip[]
  invoices    Invoice[]
  fixedCosts  FixedCost[]
  expenses    Expense[]
  messages    Message[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         UserRole
  companyId    String?
  jobTitle     String?
  /// Personal phone + avatar (a small square image data URL), self-editable.
  phone        String?
  avatar       String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  company             Company?             @relation(fields: [companyId], references: [id])
  passwordResetTokens PasswordResetToken[]
}

/// Single-use, short-lived. `usedAt` records consumption rather than deleting
/// the row, so a reused link can be told apart from one that never existed.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id        String           @id @default(cuid())
  email     String
  companyId String
  role      InvitationRole
  token     String           @unique
  expiresAt DateTime
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id])
}

model Client {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  cui             String
  address         String
  city            String
  country         String   @default("România")
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  paymentTermDays Int      @default(45)
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  orders   Order[]
  invoices Invoice[]

  @@index([companyId, name])
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_PROGRESS
  DELIVERED
  DOCUMENTS_RECEIVED
  INVOICED
  CANCELLED
}

enum Currency {
  RON
  EUR
}

enum StopType {
  LOADING
  UNLOADING
}

model Order {
  id                  String      @id @default(cuid())
  companyId           String
  year                Int
  sequence            Int
  orderNumber         String
  clientId            String
  clientReference     String
  status              OrderStatus @default(NEW)
  cargoDescription    String
  cargoWeightKg       Decimal?    @db.Decimal(10, 3)
  cargoPackaging      String?
  salePrice           Decimal     @db.Decimal(12, 2)
  currency            Currency
  exchangeRate        Decimal     @db.Decimal(10, 4)
  exchangeRateDate    DateTime    @db.Date
  salePriceRon        Decimal     @db.Decimal(12, 2)
  estimatedCostRon    Decimal?    @db.Decimal(12, 2)
  paymentTermDays     Int
  documentsReceivedAt DateTime?
  tripId              String?
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  company  Company     @relation(fields: [companyId], references: [id])
  client   Client      @relation(fields: [clientId], references: [id])
  trip     Trip?       @relation(fields: [tripId], references: [id])
  stops    OrderStop[]
  invoices Invoice[]

  @@unique([companyId, year, sequence])
  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([companyId, tripId])
}

model OrderStop {
  id            String   @id @default(cuid())
  orderId       String
  sequence      Int
  type          StopType
  locationName  String?
  address       String
  city          String
  country       String   @default("România")
  scheduledDate DateTime @db.Date
  timeFrom      String?
  timeTo        String?
  contactName   String?
  contactPhone  String?
  notes         String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, sequence])
}

enum VehicleType {
  TRACTOR_UNIT
  SEMI_TRAILER
  RIGID_TRUCK
  VAN_3_5T
}

model Vehicle {
  id                 String      @id @default(cuid())
  companyId          String
  registrationNumber String
  type               VehicleType
  make               String?
  model              String?
  manufactureYear    Int?
  vin                String?
  isActive           Boolean     @default(true)
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  documents Document[]
  tripsAsTractorUnit Trip[] @relation("TripTractorUnit")
  tripsAsTrailer     Trip[] @relation("TripTrailer")
  fixedCosts FixedCost[]
  expenses   Expense[]

  @@unique([companyId, registrationNumber])
  @@index([companyId, isActive])
}

model Driver {
  id         String    @id @default(cuid())
  companyId  String
  firstName  String
  lastName   String
  phone      String?
  email      String?
  personalId String?
  hiredAt    DateTime? @db.Date
  isActive   Boolean   @default(true)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  documents Document[]
  tripsAsPrimaryDriver Trip[] @relation("TripPrimaryDriver")
  tripsAsSecondDriver  Trip[] @relation("TripSecondDriver")
  expenses Expense[]
  messages Message[]

  @@index([companyId, lastName])
}

/// Internal dispatcher ↔ driver chat. `fromDriver` marks the direction; drivers
/// can't send yet (no driver app), so today every message is dispatcher → driver
/// and is stored for delivery once the mobile app ships.
model Message {
  id         String   @id @default(cuid())
  companyId  String
  driverId   String
  fromDriver Boolean  @default(false)
  body       String
  senderName String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([companyId, driverId, createdAt])
}

enum DocumentType {
  ITP
  RCA
  CASCO
  ROVINIETA
  TAHOGRAF
  COPIE_CONFORMA
  ASIGURARE_CMR
  PERMIS_CONDUCERE
  ATESTAT_PROFESIONAL
  CARD_TAHOGRAF
  AVIZ_MEDICAL
  AVIZ_PSIHOLOGIC
}

model Document {
  id        String       @id @default(cuid())
  companyId String
  vehicleId String?
  driverId  String?
  type      DocumentType
  number    String?
  issuedAt  DateTime?    @db.Date
  expiresAt DateTime     @db.Date
  notes     String?
  /// Photo of the document, resized client-side to a data URL (no file storage).
  imageData String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  company Company  @relation(fields: [companyId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([companyId, expiresAt])
}

enum TripStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Trip {
  id                  String     @id @default(cuid())
  companyId           String
  year                Int
  sequence            Int
  tripNumber          String
  tractorUnitId       String?
  trailerId           String?
  primaryDriverId     String?
  secondDriverId      String?
  startsAt            DateTime   @db.Date
  endsAt              DateTime   @db.Date
  /// Once the dispatcher edits the dates by hand, attaching an order must stop
  /// silently overwriting them — that would erase a manually added return day,
  /// which is exactly the date overlap detection reads.
  datesEditedManually Boolean    @default(false)
  status              TripStatus @default(PLANNED)
  /// Kilometres driven on this trip, entered by the dispatcher. Feeds the
  /// cost-per-km analysis, attributed to the trip's tractor unit.
  distanceKm          Decimal?   @db.Decimal(10, 1)
  notes               String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  company     Company  @relation(fields: [companyId], references: [id])
  tractorUnit Vehicle? @relation("TripTractorUnit", fields: [tractorUnitId], references: [id])
  trailer     Vehicle? @relation("TripTrailer", fields: [trailerId], references: [id])
  primaryDriver Driver? @relation("TripPrimaryDriver", fields: [primaryDriverId], references: [id])
  secondDriver  Driver? @relation("TripSecondDriver", fields: [secondDriverId], references: [id])
  orders      Order[]
  expenses    Expense[]

  @@unique([companyId, year, sequence])
  @@unique([companyId, tripNumber])
  @@index([companyId, status])
  @@index([companyId, startsAt])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

/// Tracks the RO e-Factura (ANAF SPV) lifecycle. No integration yet — every
/// invoice stays NOT_SENT — but the field exists so the send flow can be added
/// later without a migration or a data backfill.
enum EfacturaStatus {
  NOT_SENT
  PENDING
  SENT
  ACCEPTED
  REJECTED
}

/// A stored fiscal invoice. Party details are SNAPSHOTTED at issue time (the
/// buyer_* and seller_* columns), never read live from Company/Client — a
/// legal invoice must not change if the firm later edits its address or the
/// client is renamed. Money is Decimal end-to-end. Shaped for RO e-Factura
/// (UBL/CIUS-RO): per-line VAT, unit of measure, and an RON exchange rate for
/// foreign-currency invoices.
model Invoice {
  id        String        @id @default(cuid())
  companyId String
  /// Bucharest year of issue. Null while still a draft.
  year      Int?
  /// series / number / invoiceNumber are assigned only when the invoice is
  /// ISSUED — a draft carries no fiscal number, and Postgres treats each NULL
  /// as distinct so many drafts coexist under the unique constraints below.
  series        String?
  number        Int?
  invoiceNumber String?
  status        InvoiceStatus @default(DRAFT)

  issueDate DateTime @db.Date
  dueDate   DateTime @db.Date
  currency  Currency @default(RON)
  /// Set only when currency != RON: the RON rate frozen at issue, for the
  /// mandatory RON reporting value on the e-Factura.
  exchangeRate Decimal? @db.Decimal(10, 4)

  // Buyer snapshot (cumpărător).
  clientId     String?
  buyerName    String
  buyerCui     String
  buyerRegCom  String?
  buyerAddress String
  buyerCity    String
  buyerCounty  String?
  buyerCountry String  @default("România")

  // Seller snapshot (furnizor) — copied from Company at issue time.
  sellerName     String
  sellerCui      String
  sellerRegCom   String?
  sellerAddress  String
  sellerCity     String
  sellerCounty   String?
  sellerCountry  String  @default("România")
  sellerIban     String?
  sellerBank     String?
  sellerPhone    String?
  sellerEmail    String?
  sellerCapital  String?
  sellerVatPayer Boolean @default(true)

  // Stored totals (sum of the lines), so lists and reports never recompute.
  netTotal   Decimal @db.Decimal(12, 2)
  vatTotal   Decimal @db.Decimal(12, 2)
  grossTotal Decimal @db.Decimal(12, 2)

  notes          String?
  efacturaStatus EfacturaStatus @default(NOT_SENT)
  issuedAt       DateTime?
  paidAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company Company       @relation(fields: [companyId], references: [id])
  client  Client?       @relation(fields: [clientId], references: [id])
  orders  Order[]
  lines   InvoiceLine[]

  @@unique([companyId, invoiceNumber])
  @@unique([companyId, series, number])
  @@index([companyId, status])
  @@index([companyId, clientId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  sequence    Int
  description String
  /// Unit of measure (U.M.): buc, cursă, km, kg, lună…
  unit        String  @default("buc")
  quantity    Decimal @db.Decimal(12, 3)
  /// Preț unitar fără TVA.
  unitPrice   Decimal @db.Decimal(12, 2)
  /// VAT percentage applied to this line, e.g. 21.00.
  vatRate     Decimal @db.Decimal(5, 2)
  netAmount   Decimal @db.Decimal(12, 2)
  vatAmount   Decimal @db.Decimal(12, 2)
  grossAmount Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, sequence])
}

enum FixedCostPeriod {
  MONTHLY
  YEARLY
}

enum FixedCostCategory {
  LEASING
  INSURANCE
  TAX
  ROVINIETA
  ITP
  RENT
  SALARY
  ADMIN
  OTHER
}

enum ExpenseCategory {
  FUEL
  ADBLUE
  TOLL
  MAINTENANCE
  TIRES
  PERDIEM
  PARKING
  WASH
  FINE
  OTHER
}

/// A recurring fixed cost (cheltuială fixă). `period` is MONTHLY or YEARLY; the
/// cost/km analysis always uses the MONTHLY equivalent (a YEARLY amount ÷ 12),
/// so an annual RCA/ITP/tax is spread across the year automatically. Optionally
/// attributed to one vehicle (tractor or trailer); null = general overhead.
/// `amount` is in `currency`; a non-RON amount carries the `exchangeRate` (RON
/// per unit) frozen at entry, and the cost analysis always computes in RON.
model FixedCost {
  id           String            @id @default(cuid())
  companyId    String
  label        String
  category     FixedCostCategory @default(OTHER)
  period       FixedCostPeriod   @default(MONTHLY)
  amount       Decimal           @db.Decimal(12, 2)
  currency     Currency          @default(RON)
  exchangeRate Decimal?          @db.Decimal(10, 4)
  vehicleId    String?
  isActive     Boolean           @default(true)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  company Company  @relation(fields: [companyId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([companyId, isActive])
  @@index([companyId, vehicleId])
}

/// A one-off variable cost (cheltuială variabilă) with a date. Optionally tied
/// to a vehicle (tractor or trailer), a driver, and/or a trip. `liters` is only
/// meaningful for FUEL, feeding the l/100km consumption report. `amount` is in
/// `currency`; a non-RON amount carries the `exchangeRate` (RON per unit) frozen
/// at entry, and the cost analysis always computes in RON.
model Expense {
  id           String          @id @default(cuid())
  companyId    String
  date         DateTime        @db.Date
  category     ExpenseCategory @default(OTHER)
  amount       Decimal         @db.Decimal(12, 2)
  currency     Currency        @default(RON)
  exchangeRate Decimal?        @db.Decimal(10, 4)
  liters       Decimal?        @db.Decimal(10, 2)
  vehicleId    String?
  driverId     String?
  tripId       String?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  company Company  @relation(fields: [companyId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  driver  Driver?  @relation(fields: [driverId], references: [id])
  trip    Trip?    @relation(fields: [tripId], references: [id])

  @@index([companyId, date])
  @@index([companyId, vehicleId])
}
